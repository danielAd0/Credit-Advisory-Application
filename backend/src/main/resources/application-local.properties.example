DB_USERNAME=ca_user
DB_PASSWORD=ca_dev_2026

# Allow the Vite dev server to call the API
app.auth.cors-allowed-origins=http://localhost:5173

# Two-step sign-in. Off on your own machine until the frontend has the MFA screens.
# To try it locally: set true and add a key of your own (README, "Keys"):
#   app.mfa.encryption-key=<32 random bytes as base64, NOT the ID number keys>
app.mfa.required=false

# Local admin created on start-up (local profile only)
app.dev.admin-email=admin@local.test
app.dev.admin-password=Local-Admin-Pass-2026

# Consultant login emails (docs/consultant-onboarding.md). Without the MAIL settings the
# onboarding page works but "Send login details" says email is not set up.
app.onboarding.login-url=http://localhost:5173
